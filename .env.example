# Cinegen AI Video Generation Environment Configuration
# Add either your Replicate API Token or Fal.ai API Key below

# Replicate API (https://replicate.com/account/api-tokens)
# Used for Minimax Video-01, Luma Ray, Runway Gen-3, Wan 2.1, Kling
REPLICATE_API_TOKEN=

# Fal.ai API Key (https://fal.ai/dashboard/keys)
# Used for Fal Minimax, Luma Dream Machine, Hunyuan Video, Runway
FAL_KEY=

# Default Video Model ('minimax/video-01', 'luma/ray', 'fal-ai/minimax-video', 'fal-ai/luma-dream-machine', 'runway-gen3')
DEFAULT_VIDEO_MODEL=minimax/video-01

# Server Port (for standalone Express backend)
PORT=3001
