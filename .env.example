# Cinegen AI Text-to-Video Diffusion Studio Environment Configuration
# Add your Replicate API Token or MiniMax API Key below:

# Replicate API (https://replicate.com/account/api-tokens)
# Used for Minimax Video-01, Kling v1.6, Luma Ray / Dream Machine, Wan 2.1, Runway Gen-3
REPLICATE_API_TOKEN=

# MiniMax API Key (https://www.minimaxi.com/ / https://api.minimax.chat)
# Direct text-to-video diffusion API key
MINIMAX_API_KEY=

# Fal.ai API Key (https://fal.ai/dashboard/keys)
# Used for Fal Minimax, Luma Dream Machine, Kling serverless queue
FAL_KEY=

# Default Video Model ('minimax/video-01', 'luma/ray', 'kwaivgi/kling-v1.6-standard', 'wan-video/wan-2.1-t2v-720p', 'fal-ai/minimax-video')
DEFAULT_VIDEO_MODEL=minimax/video-01

# Server Port (for standalone Express backend)
PORT=3001
